Options -Indexes
RewriteEngine On

# www -> non-www (kanonische Domain ohne www; hält Origin konsistent fürs
# Chat-Widget, dessen CORS-Allowlist nur die non-www-Domain erlaubt)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect direkte .html-Aufrufe auf Clean URLs
RewriteCond %{REQUEST_URI} \.html$
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Statische Dateien direkt ausliefern (Assets, Fonts, Videos etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Alle anderen Requests durch router.php (Auth + Clean URLs)
RewriteRule ^ router.php [QSA,L]

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser-Caching für statische Assets (1 Jahr für versionierte Assets, kein Cache für HTML)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
